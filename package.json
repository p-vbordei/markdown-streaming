{
  "name": "markdown-streaming",
  "version": "0.2.1",
  "description": "Render Markdown to HTML incrementally as tokens arrive from an LLM. Closes unfinished inline pairs so HTML is valid at every chunk boundary. Zero dependencies.",
  "keywords": [
    "markdown",
    "streaming",
    "llm",
    "html",
    "incremental"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run build",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "engines": {
    "node": ">=20",
    "npm": ">=8"
  },
  "author": {
    "name": "Vlad Bordei",
    "email": "bordeivlad@gmail.com",
    "url": "https://github.com/p-vbordei"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/p-vbordei/markdown-streaming.git"
  },
  "bugs": {
    "url": "https://github.com/p-vbordei/markdown-streaming/issues"
  },
  "homepage": "https://github.com/p-vbordei/markdown-streaming#readme",
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^4.1.9",
    "tsup": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "prettier": "^3.3.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.mjs"
}
